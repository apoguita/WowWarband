###################################################################################################
#  WoW Warband
#
#  Server settings owned by the Warband module. The Warband client addon reads and changes the
#  live values through the .warband chat commands, so a worldserver rebuild is not needed to
#  tune them.
#
#  This file is read at startup and on .reload config.
###################################################################################################

###################################################################################################
#  Warband XP multiplier
#
#     Warband.XP.Rate
#        Server-wide experience multiplier applied to every character, followers included.
#        Whole number from 1 to 10.
#        Default: 2
#
Warband.XP.Rate = 2

###################################################################################################
#  Follower catch-up XP
#
#  Extra experience for a follower that is behind its leader. It applies on top of
#  Warband.XP.Rate, and only to a bot piloted for a real player: the random bots that populate
#  the world are never affected.
#
#  The multiplier is:  1 + (PerLevel * levels behind), with the floor and cap applied after.
#  At the defaults a follower 1 level behind gains 10% extra, and one 20 levels behind gains
#  200% extra (a x3.00 multiplier). At Warband.XP.Rate = 2 that second case receives x6.00.
#
#     Warband.CatchUp.Enabled
#        Enable the follower catch-up multiplier.
#        Default: 1 - Enabled
#
Warband.CatchUp.Enabled = 1

#     Warband.CatchUp.PerLevel
#        Extra experience per level of difference, as a fraction of 1.0. 0 disables the bonus
#        without switching catch-up off.
#        Default: 0.10
#
Warband.CatchUp.PerLevel = 0.10

#     Warband.CatchUp.MinMultiplier
#        Lowest catch-up multiplier granted while behind. 1.0 follows the plain per-level curve;
#        a higher floor keeps the last few levels quick, where a follower's own experience
#        requirement is largest and the level gap is smallest.
#        Default: 1.0
#
Warband.CatchUp.MinMultiplier = 1.0

#     Warband.CatchUp.MaxMultiplier
#        Upper limit for the catch-up multiplier. 0 disables the cap.
#        Default: 0 - uncapped
#
Warband.CatchUp.MaxMultiplier = 0

#     Warband.CatchUp.Debug
#        Log each applied catch-up multiplier, at most once per second, to the module logger.
#        Useful for verifying the effect in game.
#        Default: 0 - Disabled
#
Warband.CatchUp.Debug = 0

###################################################################################################
#  Follower gathering
#
#  The leader keeps the crafting professions; followers only need to gather for the party. When
#  enabled, every follower in the party receives the leader's Herbalism, Mining and Skinning skill
#  values, so it can work the same nodes and skin the same corpses. Playerbots already harvests
#  whenever a bot has the skill, so the skill values are all that is missing.
#
#  The values stay in step while playing, not just at recruitment: a leader that grows from 100 to
#  125 takes its followers with it. The mirror is applied on leader login, when a follower joins the
#  party, and whenever a gathering skill changes - a point gained from a node or a corpse, a rank
#  trained, .setskill, or a profession unlearned.
#
#  The mirror is a floor, never a ceiling: it only ever raises a follower. A party member that was
#  trained further, or that was the character the player logged in as in an earlier session, keeps
#  its own gathering progress instead of being dragged down to whoever is leading now. That is what
#  makes swapping which party member is played safe.
#
#  Only the three gathering skills are copied, and only the skills the leader actually has: a
#  follower never loses a skill because the leader lacks it. Recipes and crafting professions are
#  not copied - the leader is the crafter, and copying every recipe to every follower would bloat
#  their spell maps for nothing.
#
#  This writes to the follower's own character data, so it persists after the feature is disabled.
#
#     Warband.Gather.Enabled
#        Enable follower gathering mirroring. The .warband gather command still applies it on
#        demand while enabled.
#        Default: 1 - Enabled
#
Warband.Gather.Enabled = 1

#     Warband.Gather.Automatic
#        Apply the mirror automatically on leader login, when a follower joins the party, and on
#        every gathering skill change. Disable it to mirror only when .warband gather is used, which
#        also stops followers from being pulled back when they gain a point on their own.
#        Default: 1 - Enabled
#
Warband.Gather.Automatic = 1

###################################################################################################
#  Item binding
#
#  Warband is a single-player party game: a bound item is bound to the party, not to one character,
#  so binding is not treated as a barrier to moving gear. With this off, a soulbound item can be
#  traded, mailed, auctioned, put in a guild bank and handed to a companion exactly like an unbound
#  one, and an enchant that would bind an item does not stop it either. The item itself is untouched:
#  it keeps its soulbound flag, so what the game displays about it stays true.
#
#  Turning it on restores the ordinary game rule, where a bound item stays with the character that
#  bound it. That is what the client panel toggles, and the toggle is runtime only, like the other
#  Warband settings: a worldserver restart or .reload config returns it to this value.
#
#     Warband.Binding.Enforced
#        Enforce binding as a restriction on item movement. 0 is the Warband rule.
#        Default: 0 - Not enforced
#
Warband.Binding.Enforced = 0

###################################################################################################
#  Magic find
#
#  The same mechanism the core has as Rate.Drop.Item.*, but scoped to the Warband and settable while
#  playing. A multiplier applies to the drop chance of the rows that drop an item of that quality:
#
#      new chance = min(chance * multiplier, 100)
#
#  So x4 on a blue line with 20% makes it 80%, x6 on a 3% legendary makes it 18%, and a row whose
#  result passes 100% simply becomes a guaranteed drop. Nothing else changes: no rows are added or
#  removed, no extra rolls, no extra items, no duplicates, no table edits. Poor and normal are never
#  touched, so the junk distribution stays exactly as the game ships it.
#
#  Scope: the Warband's own loot - the character being played and its followers. The random bots in
#  the world keep the untouched tables, and the core's own Rate.Drop.Item.* rates stay as configured
#  and compose with these.
#
#  Two shapes a multiplier cannot reach, because there is no chance number to multiply: rows with
#  Chance = 0 inside a loot group (the game picks one of them at random instead of rolling), and
#  reference rows, whose quality lives on the rows inside the referenced table.
#
#  Values are 1.0 (no change) to 20.0. The panel's Loot quality page edits them live; the command is
#  .warband magicfind <green|blue|purple|orange|gold> <multiplier>, and .warband magicfind reset returns
#  everything to x1.
#
Warband.MagicFind.Green = 2.0
Warband.MagicFind.Blue = 4.0
Warband.MagicFind.Purple = 6.0
Warband.MagicFind.Orange = 6.0
Warband.MagicFind.Gold = 6.0

###################################################################################################
#  Gold find
#
#  The companion of magic find: a multiplier on the coin that loot generates. The module owns the
#  core's Rate.Drop.Money and re-applies this value whenever the configuration is loaded or reloaded,
#  so this setting wins over Rate.Drop.Money in worldserver.conf.
#
#  It covers every coin pile the loot system produces - creatures, chests, mines and containers - and
#  it is also applied to what a merchant pays for a sold item, to the trash auto-sell payout and to a
#  quest's own gold reward, so every gold a sale or a quest produces follows this one number. Mail
#  and the auction house are separate paths with their own rates.
#
#  Rate.Drop.Money is a world rate, so unlike magic find this applies to every player rather than to
#  the Warband's loot alone. On a single-player server that is the same thing.
#
#  Values are 1.0 (no change) to 20.0. The panel's Gold find page edits it live; the command is
#  .warband goldfind <multiplier>, and .warband goldfind reset returns it to x1.
#
Warband.GoldFind.Multiplier = 3.0

###################################################################################################
#  Supplier prices
#
#  The auctioneers are the supplier interface now: clicking one opens a category menu instead of the
#  auction house window, stocking the game's craftables, materials, reagents and recipes without
#  limit, and buying back anything. This section holds the two numbers that decide what one of them
#  charges and pays:
#
#      price = max(floor, original sell price * multiplier[quality])
#
#  The "original sell price" is the item's own SellPrice as the game shipped it, which is the number
#  on the item tooltip. It is stored once per catalogue item, so re-pricing always starts from the
#  original and a multiplier can never compound.
#
#  The same base price is charged and paid: the shops report both BuyPrice and SellPrice as this
#  value. What a player receives for selling an item to a merchant is that value multiplied by the
#  Warband gold multiplier (the one gold find pushes into the coin rate), so the multiplier is paid
#  out on selling.
#
#  These keys only seed the first run. The live values live in the world database
#  (warband_supplier_setting), which is what the panel's Supplier prices page and the .warband price
#  command edit, so a value set in game wins over this file and survives restarts. Change a key here
#  and it takes effect only for a value nothing has saved yet. .warband price reset goes back to the
#  shipped rule below.
#
#  A price is written onto the item itself (item_template.BuyPrice and SellPrice), because the core
#  reads the item's own prices and no hook can scale them per quality. The item table is read once at
#  startup, so after pressing Apply the new prices are visible after a worldserver restart. Nothing
#  is re-priced by itself: prices change only when you press Apply or run .warband price apply.
#
#     Warband.Suppliers.Multiplier.<quality>
#        One multiplier per item quality, 1.0 to 20.0. The shipped rule is 2 for poor, 1 for
#        normal, then 4 through 9 for uncommon to heirloom: a common item keeps its own vendor
#        value (a Field Repair Bot stays at its 1 gold), the rarer qualities are raised.
#
#     Warband.Suppliers.Floor
#        The lowest price, in copper, that a supplier charges or pays. 1 to 1000000.
#
#  The command is .warband price <poor|normal|uncommon|rare|epic|legendary|artifact|heirloom>
#  <multiplier>, .warband price floor <copper>, .warband price apply, .warband price reset.
#
Warband.Suppliers.Multiplier.Poor = 2.0
Warband.Suppliers.Multiplier.Normal = 1.0
Warband.Suppliers.Multiplier.Uncommon = 4.0
Warband.Suppliers.Multiplier.Rare = 5.0
Warband.Suppliers.Multiplier.Epic = 6.0
Warband.Suppliers.Multiplier.Legendary = 7.0
Warband.Suppliers.Multiplier.Artifact = 8.0
Warband.Suppliers.Multiplier.Heirloom = 9.0
Warband.Suppliers.Floor = 10

###################################################################################################
#  Trash auto-sell
#
#  A Warband of five loots five bags' worth of grey junk, and a follower's bags cannot be opened by
#  hand the way the leader's can. With this enabled, a grey item is sold the moment it is picked up:
#  it never stays in any bag, the vendor price is paid into the leader's purse, and the item is
#  gone. The leader is the one purse you can see, so the party's junk money stays in one place
#  instead of filling follower purses nobody can open. The panel counts only this Warband's sales,
#  keyed by the leader and starting again at zero when the leader logs in.
#
#  It covers the leader and every follower, because the follower is the one filling a bag nobody can
#  clean out. It does not touch quest items, items that start a quest, or anything an accepted quest
#  still needs, and a grey with no vendor price is left where it is rather than deleted for nothing.
#
#  A pickup only happens when the picking character has a free slot, so a bag that is already full
#  cannot be emptied by looting. .warband trash sell sweeps the whole party's bags instead, which is
#  what clears an existing accumulation. The panel's Trash sell page does the same with a button.
#
#     Warband.TrashSell.Enabled
#        Sell grey loot at pickup time, for the leader and every follower.
#        Default: 1 - Enabled
#
Warband.TrashSell.Enabled = 1

###################################################################################################
#  Instances stop restocking
#
#  A creature that dies inside a dungeon or raid does not come back for the run. Its respawn time is
#  pushed ten years out and saved to the character database, which is why a cleared corridor stays
#  cleared even after the instance unloads (Instance.UnloadDelay: 30 minutes with nobody inside) or
#  after a server restart.
#
#  An instance reset still brings everything back - the client's "Reset all instances", a GM reset,
#  or the daily reset hour. That is what a reset is for, so nothing here fights it.
#
#  Only dungeons and raids, and only creatures the party killed: a follower's kill counts, and a
#  summon's kill counts through its owner. Open-world respawns are untouched.
#
#     Warband.Instances.NoRespawn
#        Keep instance creatures dead for the run. The panel's Instances page toggles this live.
#        Default: 1 - Enabled
#
Warband.Instances.NoRespawn = 1

#     Warband.Instances.NeverAdjust.CreatureID
#     Warband.Instances.NeverAdjust.InstanceID
#        Space-separated ids that keep their ordinary respawn timers, for a creature or a map that
#        has to come back (a summoning object's guards, a respawning event mob, a test map).
#        Default: empty
#
Warband.Instances.NeverAdjust.CreatureID =
Warband.Instances.NeverAdjust.InstanceID =

###################################################################################################
#  Convenience: hearthstone and pet happiness
#
#  Two small quality-of-life rules, both aimed at the same problem: a single player runs five
#  characters, and two of the game's timers cannot be kept up by hand.
#
#  Hearthstone. Using it starts a 15-minute cooldown on spell 8690 (and on 39937, the TBC twin some
#  clients use). With this on, the cooldown is cleared the moment the hearthstone cast turns into a
#  teleport, and once more on login - so the item is always ready.
#
#  Pets. A hunter pet's happiness is the POWER_HAPPINESS power, drained on a timer and knocked down a
#  step whenever the pet dies. A follower cannot be told to feed its pet, so in a Warband the pet
#  drifts into "unhappy" and its damage never recovers. With this on every pet's happiness is topped
#  up, the leader's included.
#
#     Warband.Hearthstone.AlwaysReady
#        Clear the hearthstone cooldown as soon as the item is used.
#        Default: 1 - Enabled
#
Warband.Hearthstone.AlwaysReady = 1

#     Warband.Pets.AlwaysHappy
#        Keep every hunter pet at full happiness.
#        Default: 1 - Enabled
#
Warband.Pets.AlwaysHappy = 1

#     Warband.Quests.ScaleStep
#        Quests present at the highest multiple of this step the character has reached, so they
#        never slide into the gray band as the character levels: a level-15 quest reads and pays
#        as a level-20 quest once the character is 20-24, then as level 25 from 25, and so on
#        (never lowered; a quest whose own level is already above the character keeps its level).
#        The level the client shows is sent by the quest-query packet (a Warband core deviation);
#        the awarded experience is corrected to match, and quest reward items are scaled to the
#        same level by mod-item-level-scaling when ItemScaling.QuestRewards is on.
#        Default:     5 - five-level steps
#                     0 - off, quests keep their own level
#
Warband.Quests.ScaleStep = 5

###################################################################################################
#  Random world bots
#
#  The bots that wander the world are not Warband's: the playerbots module logs its random bots in
#  and out on its own schedule, reading Playerbots.RandomBotAutologin and a population between
#  Playerbots.MinRandomBots and Playerbots.MaxRandomBots in playerbots.conf. This module adds no key
#  of its own. It reports that state and lets the Warband panel and .warband randombots change it:
#
#     .warband randombots              read the state
#                                     (WARBAND_RANDOMBOTS=enabled=1;target=500;online=123)
#     .warband randombots off          stop new logins and log out the random bots online now
#     .warband randombots on           restore the population at the target below
#     .warband randombots set <1-500>  pin how many random bots stay online
#
#  Every change is applied at once and written into modules/playerbots.conf - the autologin switch
#  and the two population bounds, nothing else in that file - so the next startup holds the same
#  state. Nothing is stored here: this module adds no key of its own, it only drives the three
#  playerbots options. The Warband's own companions are never random bots, so this switch can never
#  touch the party.

###################################################################################################


