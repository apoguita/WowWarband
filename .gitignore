# ==================
#
#  CUSTOM
#
#  put below your custom ignore rules
#  for example , if you want to include a
#  module directly in repositoryyou can do:
#
#  !modules/yourmodule
#
# ==================

!/modules/mod-warband/
!/modules/mod-warband/**

# Live-stack e2e private / local tooling (scratch tests stay uncommitted)
e2e/local/**
!e2e/local/README.md
e2e/go.work
e2e/go.work.sum

.cache
compile_commands.json

# Local tooling scratch: npm/pip caches, temp directories and logs that tools create when they run
# with the repository root as their working directory (for example `python -m pip install --target .`
# or an `npm exec` from the root). These are never meant to be committed.
.npm-cache/
.pip-cache/
.pip-tmp/
.pip-log.txt
/build-*.log
/configure-*.log
